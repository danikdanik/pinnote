{
  "manifest_version": 3,
  "name": "PinNote",
  "version": "0.1.0",
  "description": "Drop notes on any live web page for UX reviews. Shift+Click to annotate, export to agent-ready markdown.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Toggle PinNote",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pinnote.js", "errors.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
